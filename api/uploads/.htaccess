# =============================================================================
# Sécurité uploads Nexytal — api/uploads/
# Bloque toute exécution de scripts ; autorise uniquement les médias servis.
# Compatible Apache 2.4 (Ionos). Les en-têtes Cache-Control profitent au CDN Cloudflare.
# =============================================================================

Options -Indexes -ExecCGI -MultiViews

# Désactiver le moteur PHP dans ce dossier (mod_php / hébergement mutualisé)
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

# Retirer les handlers d'exécution sur extensions dangereuses
<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .phar .cgi .pl .py .sh
  RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .phar .cgi .pl .py .sh
</IfModule>

# --- Bloquer explicitement les scripts et fichiers sensibles ---
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phtml|phps|phar|cgi|pl|py|rb|sh|bash|exe|dll|so|asp|aspx|jsp|jspx|shtml|htaccess|htpasswd|ini|config|env)$">
  Require all denied
</FilesMatch>

# --- Types MIME explicites (évite le sniffing navigateur) ---
<IfModule mod_mime.c>
  AddType image/jpeg         .jpg .jpeg
  AddType image/png          .png
  AddType image/gif          .gif
  AddType image/webp         .webp
  AddType image/svg+xml      .svg
  AddType application/pdf    .pdf
  AddType video/mp4          .mp4
  AddType video/webm         .webm
  AddType video/quicktime    .mov
  AddType video/x-msvideo    .avi
</IfModule>

# --- En-têtes sécurité + cache CDN pour les médias autorisés ---
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(jpe?g|png|gif|webp|svg|pdf|mp4|webm|mov|avi)$">
    Header set X-Content-Type-Options "nosniff"
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset X-Powered-By
  </FilesMatch>

  # SVG : pas de scripts embarqués côté navigateur
  <FilesMatch "(?i)\.svg$">
    Header set Content-Security-Policy "default-src 'none'; script-src 'none'; object-src 'none';"
  </FilesMatch>
</IfModule>

# --- Expiration longue durée (mod_expires, complément Cloudflare) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType application/pdf         "access plus 1 month"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType video/webm              "access plus 1 year"
  ExpiresByType video/quicktime         "access plus 1 year"
  ExpiresByType video/x-msvideo         "access plus 1 year"
</IfModule>

# --- Refuser tout fichier dont l'extension n'est pas dans la liste blanche ---
<FilesMatch "\.(?!(?i:jpe?g|png|gif|webp|svg|pdf|mp4|webm|mov|avi)$)[^.]+$">
  Require all denied
</FilesMatch>
