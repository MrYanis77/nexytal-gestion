# Copiez en api/config/.env ou api/config/env sur le FTP (ne pas committer)
# Ionos → Bases de données → dbs15772578
# Sur Ionos, préférez le fichier « env » (sans point) : plus fiable à uploader

DB_HOST=db5020658636.hosting-data.io
DB_PORT=3306
DB_NAME=dbs15772578
DB_USER=dbu977482
DB_PASSWORD=remplacer_par_mot_de_passe_ionos
DB_CHARSET=utf8mb4

APP_ENV=production
JWT_SECRET=generer_une_cle_secrete_longue_et_aleatoire

# OBLIGATOIRE en production (32+ caractères, valeur unique) — sans cela l'API renvoie 503.
# Ne jamais utiliser la valeur par défaut du code source.

# Proxys autorises a fournir X-Forwarded-For / X-Real-IP (Ionos/Cloudflare si utilise)
TRUSTED_PROXIES=127.0.0.1,::1

# Logs serveur consultables depuis l'admin (chemins separes par des virgules)
# Laisser vide = detection automatique error_log / logs/error.log / php_errors.log
SYSTEM_LOG_PATHS=
SYSTEM_LOG_TAIL_BYTES=1048576
# Tests insertion BDD — GET /api/health/insert/run?key=...
INSERT_TEST_KEY=nexytal-insert-test

# --- Uploads & CDN ---
# Chemins servis par l'API (ne pas modifier sauf refonte routing)
# UPLOAD_URL=/api/uploads/

# Domaine couvert par le CDN Ionos/Cloudflare (sans slash final)
# Laisser vide = chemins relatifs (same-origin). Ex. sous-domaine CDN :
# MEDIA_PUBLIC_BASE_URL=https://www.connexion.nexytal.com

# Tailles max (octets) — images 5 Mo, vidéos 100 Mo, PDF 10 Mo
# UPLOAD_MAX_SIZE_IMAGE=5242880
# UPLOAD_MAX_SIZE_VIDEO=104857600
# UPLOAD_MAX_SIZE_DOCUMENT=10485760

# Marge disque à conserver après upload (256 Mo par défaut)
# UPLOAD_MIN_FREE_BYTES=268435456

# --- Emails (SMTP Ionos) — requis pour les mails de validation recruteur / coach / formateur ---
MAIL_TO=contact@nexytal.com
MAIL_FROM=contact@nexytal.com
MAIL_FROM_NAME=Nexytal
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_USER=contact@nexytal.com
SMTP_PASSWORD=remplacer_par_mot_de_passe_smtp
SMTP_ENCRYPTION=ssl

# Chemins d'activation portail (domaine lu depuis core_sites)
# PORTAL_PATH_RECRUTEUR_ACTIVATE=/recruteur/activer
# PORTAL_PATH_COACH_ACTIVATE=/espace-coach/activer
# PORTAL_PATH_TRAINER_ACTIVATE=/espace-formateur/activer
